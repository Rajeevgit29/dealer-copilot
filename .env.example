# Postgres. Local: createdb dealer_copilot
DATABASE_URL=postgres://localhost:5432/dealer_copilot

# Salt for hashing farmer phone numbers (any long random string)
PHONE_SALT=change-me-to-a-long-random-string

# Optional: enables photo reading (label scan + pest diagnosis).
# Without it the app runs in demo mode with sample photos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary model is overloaded or times out.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest
