              "raw": "{\n  \"field\": {\n    \"crop\": \"tomato\",\n    \"sowingDate\": \"2026-08-01\",\n    \"areaAcres\": 1,\n    \"nextHarvestDate\": \"2026-11-11\"\n  },\n  \"history\": [],\n  \"pestId\": \"fruit_borer\",\n  \"today\": \"2026-11-09\"\n}",
              "options": {
